{
  "name": "transport-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Transportation Management System for employee shuttle services",
  "scripts": {
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:generate": "npm --prefix server run db:generate",
    "db:seed": "npm --prefix server run db:seed",
    "db:studio": "npm --prefix server run db:studio",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "test": "npm --prefix server run test",
    "admin:create": "npm --prefix server run admin:create",
    "demo:seed": "npm --prefix server run db:seed && npm --prefix server run demo:seed",
    "db:deploy": "npm --prefix server run db:deploy",
    "demo:showcase": "npm --prefix server run demo:showcase"
  }
}
