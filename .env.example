# Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tms_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-tms-access-key-2026-xyz-change-in-prod"
JWT_REFRESH_SECRET="super-secret-tms-refresh-key-2026-abc-change-in-prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS
CLIENT_ORIGIN="http://localhost:5173"
